# PRODUCTION SUPABASE CONFIGURATION
# 1. Log in to Supabase Dashboard (https://supabase.com)
# 2. Go to Project Settings > API
# 3. Copy the URL and the 'anon' public key here
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# PAYMENT GATEWAY (Nepal)
VITE_ESEWA_MERCHANT_ID=EPAYTEST
VITE_ESEWA_SUCCESS_URL=http://localhost:8080/checkout/success
VITE_ESEWA_FAILURE_URL=http://localhost:8080/checkout/failure

# Feature flags
# Set to "true" to enable eSewa payment gateway
VITE_ESEWA_ENABLED=false
# Set to "false" to disable subscription gating on store features
VITE_REQUIRE_SUBSCRIPTION=true

# ────────────────────────────────────────────────────────────────
# Supabase Edge Function Secrets
# Set these in: Supabase Dashboard → Project → Edge Functions → Secrets
# ────────────────────────────────────────────────────────────────

# eSewa payment gateway (required if VITE_ESEWA_ENABLED=true)
ESEWA_MERCHANT_ID=your-esewa-merchant-id
ESEWA_SECRET_KEY=your-esewa-secret-key

# Your deployed frontend URL — used for eSewa redirect URLs
SITE_URL=https://tamrakarcomplex.com

# Supabase service role key — for edge functions (bootstrap-admin, valuation-estimator)
# Find it in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Restrict which origins can call edge functions (comma-separated)
# Defaults to https://tamrakarcomplex.com if not set
ALLOWED_ORIGINS=https://tamrakarcomplex.com

# cPanel / Node.js hosting only
NODE_ENV=production
PORT=3000
